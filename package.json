{
  "name": "@sehv-oss/typescript-config",
  "version": "0.0.1",
  "description": "Shared TypeScript configurations for Node.js/web libraries and applications",
  "type": "module",
  "exports": {
    "./base": "./base.json",
    "./node/base": "./node/base.json",
    "./node/app": "./node/app.json",
    "./node/lib": "./node/lib.json",
    "./node/cli": "./node/cli.json",
    "./web/base": "./web/base.json",
    "./web/app": "./web/app.json",
    "./web/lib": "./web/lib.json",
    "./layer/react": "./layer/react.json",
    "./layer/composite": "./layer/composite.json",
    "./layer/test": "./layer/test.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint:cspell": "cspell --config .cspell.config.ts .",
    "lint:prettier": "prettier --config .prettier.config.ts --check .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "files": [
    "base.json",
    "node",
    "web",
    "layer"
  ],
  "keywords": [
    "typescript",
    "tsconfig",
    "typescript-config"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sehv-oss/typescript-config.git"
  },
  "peerDependencies": {
    "typescript": ">=7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@sehv-oss/cspell-config": "1.1.1",
    "@sehv-oss/prettier-config": "1.0.2",
    "@types/node": "26.4.1",
    "cspell": "10.2.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
